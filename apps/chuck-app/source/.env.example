# Copy to .env.local and fill in for local dev. The DEPLOYED app gets pod context
# injected at serve time (window.__LEMMA_CONFIG__), so these only matter for `npm run dev`.
#
# For same-origin dev without CORS, set the API URL to /api and point the proxy at your
# backend (the Vite config forwards /api → LEMMA_DEV_PROXY_TARGET).

VITE_LEMMA_API_URL="/api"
VITE_LEMMA_AUTH_URL="https://<your-lemma-host>/auth"
VITE_LEMMA_POD_ID="<your-pod-id>"
VITE_LEMMA_APP_NAME="Chuck"
VITE_LEMMA_APP_BASE_PATH="/"
LEMMA_DEV_PROXY_TARGET="https://<your-lemma-api-host>"
